<Project>
    <PropertyGroup>
        <!-- Drop TFMs that aren’t valid on this OS (e.g. iOS/macOS on Linux) -->
        <DisableUnsupportedTargetFrameworks>true</DisableUnsupportedTargetFrameworks>

        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- All CatUI projects need to be AOT-compatible -->
        <IsAotCompatible>True</IsAotCompatible>

        <Version>0.1.0</Version>
        <Copyright>Copyright (c) moldovanedy 2025</Copyright>
        <PackageTags>UI;User Interface;fast</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Authors>Moldovan Eduard</Authors>
    </PropertyGroup>
</Project>
