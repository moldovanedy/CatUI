<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <DefineConstants Condition="'$(RuntimeIdentifier)' == 'win-x64'">$(DefineConstants);WINDOWS_X86_64</DefineConstants>
        <DefineConstants Condition="'$(RuntimeIdentifier)' == 'win-x86'">$(DefineConstants);WINDOWS_X86</DefineConstants>
        <DefineConstants Condition="'$(RuntimeIdentifier)' == 'win-arm64'">$(DefineConstants);WINDOWS_ARM64</DefineConstants>

        <DefineConstants Condition="'$(RuntimeIdentifier)' == 'osx-x64'">$(DefineConstants);MAC_OS_X86_64</DefineConstants>
        <DefineConstants Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">$(DefineConstants);MAC_OS_ARM64</DefineConstants>

        <DefineConstants Condition="'$(RuntimeIdentifier)' == 'linux-x64'">$(DefineConstants);LINUX;LINUX_X86_64</DefineConstants>
        <DefineConstants Condition="'$(RuntimeIdentifier)' == 'linux-arm'">$(DefineConstants);LINUX;LINUX_ARM</DefineConstants>
        <DefineConstants Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">$(DefineConstants);LINUX;LINUX_ARM64</DefineConstants>

        <Version>0.1.0</Version>
        <Title>CatUI.Utils</Title>
        <Description>
            Contains some basic utilities that are actually independent of CatUI and can be used in any project
            even if it doesn't use CatUI.
        </Description>
        <Copyright>Copyright (c) moldovanedy 2025</Copyright>
        <PackageTags>UI;User Interface;fast</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Authors>Moldovan Eduard</Authors>

        <IsAotCompatible>True</IsAotCompatible>
    </PropertyGroup>

</Project>
