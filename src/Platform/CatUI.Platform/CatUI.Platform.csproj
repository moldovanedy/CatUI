<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>

        <Title>CatUI.Platform</Title>
        <Description>
            Contains the unified API for accessing different platform-specific APIs, like native alerts, file pickers,
            notifications, and more. This can be used in non-CatUI applications, even the ones built in other UI
            frameworks.
        </Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CatUI.Platform.Essentials\CatUI.Platform.Essentials.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
        <ProjectReference Include="..\CatUI.Platform.Windows\CatUI.Platform.Windows.csproj" />
        <ProjectReference Include="..\CatUI.Platform.MacOS\CatUI.Platform.MacOS.csproj" />
        <ProjectReference Include="..\CatUI.Platform.Linux\CatUI.Platform.Linux.csproj" />
        <ProjectReference Include="..\CatUI.Platform.DesktopCommon\CatUI.Platform.DesktopCommon.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
        <ProjectReference Condition="$(RuntimeIdentifier.StartsWith('win'))" Include="..\CatUI.Platform.Windows\CatUI.Platform.Windows.csproj" />
        <ProjectReference Condition="$(RuntimeIdentifier.StartsWith('osx'))" Include="..\CatUI.Platform.MacOS\CatUI.Platform.MacOS.csproj" />
        <ProjectReference Condition="$(RuntimeIdentifier.StartsWith('linux')) Or $(RuntimeIdentifier.StartsWith('unix'))" Include="..\CatUI.Platform.Linux\CatUI.Platform.Linux.csproj" />
        <ProjectReference Condition="$(RuntimeIdentifier.StartsWith('win')) Or $(RuntimeIdentifier.StartsWith('osx')) Or $(RuntimeIdentifier.StartsWith('linux')) Or $(RuntimeIdentifier.StartsWith('unix'))" Include="..\CatUI.Platform.DesktopCommon\CatUI.Platform.DesktopCommon.csproj" />
    </ItemGroup>

</Project>
