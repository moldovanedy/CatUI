<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!--<CatUseAngle>true</CatUseAngle>-->

        <Title>CatUI.RenderingEngine</Title>
        <Description>Contains the core rendering of CatUI, essential for an application that uses CatUI.</Description>
    </PropertyGroup>

    <PropertyGroup Condition="'$(CatUseAngle)' == 'true'">
        <DefineConstants>$(DefineConstants);CAT_USE_ANGLE</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp" />

        <PackageReference Condition="$(DefineConstants.Contains('CAT_ANY_PLATFORM')) Or $(DefineConstants.Contains('CAT_WINDOWS'))" Include="SkiaSharp.NativeAssets.Win32" />
        <PackageReference Condition="$(DefineConstants.Contains('CAT_ANY_PLATFORM')) Or $(DefineConstants.Contains('CAT_MACOS'))" Include="SkiaSharp.NativeAssets.macOS" />
        <PackageReference Condition="$(DefineConstants.Contains('CAT_ANY_PLATFORM')) Or $(DefineConstants.Contains('CAT_LINUX'))" Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CatUI.Data\CatUI.Data.csproj" />
        <ProjectReference Include="..\CatUI.Utils\CatUI.Utils.csproj" />
    </ItemGroup>

</Project>
