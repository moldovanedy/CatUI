<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <Version>0.1.0</Version>
        <Title>CatUI.Data</Title>
        <Description>
            Contains most of the data containers for almost every aspect of CatUI, including brushes, event arguments,
            colors and geometry descriptors. It is closely tied to CatUI and SkiaSharp, so using it in a non-CatUI project
            doesn't have much sense, except for some classes that are simply data containers.
        </Description>
        <Copyright>Copyright (c) moldovanedy 2025</Copyright>
        <PackageTags>UI;User Interface;fast</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Authors>Moldovan Eduard</Authors>

        <IsAotCompatible>True</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) Or $(RuntimeIdentifier.StartsWith('win'))">
        <DefineConstants>$(DefineConstants);CAT_LOCAL_WINDOWS</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) Or $(RuntimeIdentifier.StartsWith('osx'))">
        <DefineConstants>$(DefineConstants);CAT_LOCAL_MACOS</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) Or $([MSBuild]::IsOSPlatform('FreeBSD')) Or $(RuntimeIdentifier.StartsWith('linux')) Or $(RuntimeIdentifier.StartsWith('unix'))">
        <DefineConstants>$(DefineConstants);CAT_LOCAL_LINUX</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="2.88.8" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Platform\CatUI.Platform.Essentials\CatUI.Platform.Essentials.csproj" />
        <ProjectReference Include="..\CatUI.Utils\CatUI.Utils.csproj" />

        <!-- we cannot use the defined symbols like CAT_LOCAL_WINDOWS as they don't work here... -->
        <ProjectReference Condition="$([MSBuild]::IsOSPlatform('Linux')) Or $([MSBuild]::IsOSPlatform('FreeBSD')) Or $(RuntimeIdentifier.StartsWith('linux')) Or $(RuntimeIdentifier.StartsWith('unix'))" Include="..\Platform\CatUI.Platform.Linux\CatUI.Platform.Linux.csproj" />
        <ProjectReference Condition="$([MSBuild]::IsOSPlatform('Windows')) Or $(RuntimeIdentifier.StartsWith('win'))" Include="..\Platform\CatUI.Platform.Windows\CatUI.Platform.Windows.csproj" />
    </ItemGroup>

</Project>
